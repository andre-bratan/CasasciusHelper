{
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "DataFolder": "Data"
  },
  "DuckDbSettings": {
    "DataSource": "CasasciusHelper.duckdb",
    "HomeDirectory": "Data",
    "FileSearchPath": "Data",
    "MemoryLimit": "256Mb"
  },
  "Logging": {
    "Console": {
      "FormatterName": "Simple",
      "FormatterOptions": {
        "IncludeScopes": false,
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "ColorBehavior": "Enabled"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning"
    }
  }
}
