@using CasasciusHelper.Components.Custom
@using CasasciusHelper.Core.State
@implements IDisposable
@inherits LayoutComponentBase

@inject ApplicationState ApplicationState

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 justify-content-start">

            <span class="me-3">
                <DatabaseStatus />
            </span>

            <span class="fw-bold text-danger">
                @ApplicationState.StatusLine
            </span>

            <a class="ms-auto" href="https://github.com/andre-bratan/CasasciusHelper" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {

    protected override void OnInitialized()
    {
        //await base.OnInitializedAsync();

        lock (disposeLock)
        {
            // disposal may happen even during initialization
            if (!disposed)
            {
                ApplicationState.RegisterStateChangedCallback(StateChangedCallback);
            }
        }
    }

    private void StateChangedCallback(object? sender, EventArgs args)
    {
        // NOTE: this call is not awaited
        InvokeAsync(() =>
        {
            // Protect against event-handler-invocation race conditions with disposing.
            lock (disposeLock)
            {
                if (!disposed)
                {
                    StateHasChanged();
                }
            }
        });
    }

    private readonly object disposeLock = new();
    private volatile bool disposed;

    public void Dispose()
    {
        lock (disposeLock)
        {
            disposed = true;
            ApplicationState?.UnregisterStateChangedCallback(StateChangedCallback);
        }
    }
}
