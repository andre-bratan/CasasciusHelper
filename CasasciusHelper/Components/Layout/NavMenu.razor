@using CasasciusHelper.Core.State
@inject ApplicationState ApplicationState

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Casascius Helper</a>
        <span class="me-auto text-muted text-sm-start" data-toggle="tooltip" data-placement="bottom" title="@ApplicationState.CommitHash">@ApplicationState.Version</span>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="signatures">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Signatures
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="apiExamples">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Api Help
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="swagger">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Swagger
            </NavLink>
        </div>
    </nav>
</div>
