<Project>
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
        <!-- The following parameter enabled fixes error (which reproduces only on development machine, i.e. doesn't reproduce on CI):
             Error NU1605 : Warning As Error: Detected package downgrade: B.Utils from x.x.x to x.x.x. Reference the package directly from the project to select a different version.
        -->
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>
    <ItemGroup Label="Annotations and code quality">
        <!-- https://github.com/JetBrains/JetBrains.Annotations/tags -->
        <PackageVersion Include="JetBrains.Annotations" Version="2024.3.0" />
    </ItemGroup>
    <ItemGroup Label=".NET Core">
        <!-- https://github.com/dotnet/runtime/releases -->
        <!-- https://github.com/dotnet/extensions/releases -->
        <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    </ItemGroup>
    <ItemGroup Label="Other Databases and Data Providers">
        <!-- https://github.com/DapperLib/Dapper/releases -->
        <PackageVersion Include="Dapper" Version="2.1.44" />
        <!-- https://github.com/Giorgi/DuckDB.NET/tags -->
        <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.1.3" />
    </ItemGroup>
    <ItemGroup Label="Application related references">
        <!-- https://github.com/bcgit/bc-csharp/tags -->
        <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />
        <!-- https://github.com/MetacoSA/NBitcoin/tags -->
        <PackageVersion Include="NBitcoin" Version="8.0.18" />
    </ItemGroup>
    <ItemGroup Label="API">
        <!-- TODO: Migrate to OpenAPI after .NET 8 -->
        <!-- https://github.com/domaindrivendev/Swashbuckle.AspNetCore/releases -->
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    </ItemGroup>
    <ItemGroup Label="Tests related references">
        <!-- https://github.com/dotnet/aspnetcore/releases -->
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
        <!-- In apps that use xunit.runner.visualstudio version 2.4.2 or later, the test project must reference the Microsoft.NET.Test.Sdk package.-->
        <!-- https://github.com/microsoft/vstest/releases -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />

        <!-- https://fluentassertions.com/releases/, https://github.com/fluentassertions/fluentassertions/releases -->
        <!-- WARNING: Starting from v8 the library is not free! Consider migrating to Shouldly -->
        <PackageVersion Include="FluentAssertions" Version="6.12.1" />

        <!-- https://github.com/nsubstitute/NSubstitute/releases -->
        <PackageVersion Include="NSubstitute" Version="5.3.0" />
        <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageVersion>

        <!-- https://xunit.net/releases/v2/ -->
        <PackageVersion Include="xunit" Version="2.9.2" />
        <!-- https://xunit.net/releases/visualstudio/ -->
        <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageVersion>

        <!-- Code coverage related references -->
        <!-- https://github.com/coverlet-coverage/coverlet/releases -->
        <PackageVersion Include="coverlet.collector" Version="6.0.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageVersion>
        <!-- https://github.com/spekt/junit.testlogger/releases -->
        <PackageVersion Include="JunitXml.TestLogger" Version="4.1.0" />
    </ItemGroup>
</Project>
